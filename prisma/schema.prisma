// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum Role {
  SUPER_ADMIN
  STUDENT
}

enum AccountStatus {
  ACTIVE
  LOCKED
}

// Declared in ladder order (Cấp 0 → Cấp 5); src/lib/levels.ts is the single
// source of truth for the rank and display name of each.
//
// Renamed from the old five-tier ladder (CUSTOMER/NEW_STARTER/JUNIOR/SENIOR/
// CORE_LEADER) on 2026-08-18. Note the trap that migration had to work
// around: CUSTOMER exists in both ladders but at a different rank — Cấp 1
// before, Cấp 3 now — so the values could not simply be renamed in place.
// Every account kept the rank it already held (old Cấp N → new Cấp N), which
// is why VISITOR starts out empty; see the migration for the exact mapping.
enum Level {
  VISITOR
  REGISTERED_MEMBER
  IGNITE_MEMBER
  CUSTOMER
  BUSINESS_BUILDER
  TEAM_PARTNER
}

enum LevelUpStatus {
  PENDING
  APPROVED
  REJECTED
}

enum AnnouncementCategory {
  IMPORTANT
  UPDATE
  GENERAL
}

enum LibraryItemType {
  BOOK
  DOCUMENT
}

// Discriminates how a LibraryItem is authored/served — PDF (uploaded file,
// today's only path) vs INTERACTIVE (pages composed in the admin editor,
// see LibraryBookPage). Independent of LibraryItemType (BOOK/DOCUMENT),
// which is about the item's physical form, not its content source.
enum LibraryItemFormat {
  PDF
  INTERACTIVE
}

enum ChatThreadKind {
  SUPPORT
  DIRECT
  GROUP
}

enum OrderStatus {
  PENDING
  PAID
  CANCELLED
}

enum OrderItemKind {
  COURSE
  LIBRARY_ITEM
  PRODUCT
}

enum WhiteboardAccessRole {
  VIEWER
  COMMENTER
  EDITOR
}

// Infinite-canvas collaborative whiteboard ("Bảng vẽ") — reachable by every
// non-guest audience (Super Admin, Admin, học viên) once
// Settings.whiteboardsEnabled is on (see requireWhiteboardsEnabled in
// src/lib/access.ts), unlike most other content models which are admin-only
// to create. Access to one specific board is Google-Drive-style, resolved
// by requireWhiteboardAccess: owner (createdBy) always full access, named
// WhiteboardCollaborator rows next, then generalAccessRole as a fallback
// for anyone signed in with the link. `elements` is the entire canvas as one
// JSON array (whole-array last-write-wins autosave + Realtime broadcast, see
// use-whiteboard-broadcast.ts) validated by whiteboardElementsPayloadSchema
// in src/lib/whiteboard-elements.ts — not enforced at the DB layer.
model Whiteboard {
  id                String                @id @default(cuid())
  title             String
  createdById       String?
  createdBy         User?                 @relation("WhiteboardsCreated", fields: [createdById], references: [id], onDelete: SetNull)
  lastEditedById    String?
  lastEditedBy      User?                 @relation("WhiteboardsEdited", fields: [lastEditedById], references: [id], onDelete: SetNull)
  elements          Json                  @default("[]")
  viewportX         Float                 @default(0)
  viewportY         Float                 @default(0)
  viewportZoom      Float                 @default(1)
  createdAt         DateTime              @default(now())
  updatedAt         DateTime              @updatedAt
  // null = "Hạn chế" (restricted to the owner + named collaborators only,
  // the default for a newly created board) — a non-null value opens the
  // board to anyone signed in with the link, at that role (see
  // requireWhiteboardAccess's step 4, which also auto-upserts a
  // WhiteboardCollaborator row the first time a non-collaborator opens the
  // board this way, mirroring real Google Drive's "Shared with me").
  generalAccessRole WhiteboardAccessRole?

  collaborators  WhiteboardCollaborator[]
  commentThreads WhiteboardCommentThread[]

  @@index([updatedAt])
}

// One pinned discussion attached to a specific element — created from that
// element's own selection toolbar (see comment-pins.tsx), so the pin moves
// and scales along with it, same as the reference video's behavior. No FK
// to an actual element row: elements live inside Whiteboard.elements' JSON
// blob, not their own table, so this is just a plain string id resolved
// client-side against that array — a thread whose element was since
// deleted simply stops rendering, same "just no-ops" convention as a
// connector pointing at a deleted element. Anyone who can open the board at
// all (VIEWER/COMMENTER/EDITOR/OWNER — see canManageWhiteboardSharing in
// src/lib/access.ts, which this does NOT gate behind) can create one and
// reply to any thread; only content edits stay gated behind canEditWhiteboard.
model WhiteboardCommentThread {
  id           String     @id @default(cuid())
  whiteboardId String
  whiteboard   Whiteboard @relation(fields: [whiteboardId], references: [id], onDelete: Cascade)
  elementId    String
  // Anchor position as a FRACTION of the element's own width/height (0/0 =
  // top-left corner, 1/1 = bottom-right) rather than absolute px — this is
  // what makes the pin track the element correctly through both a move AND
  // a resize, not just a move. Can sit slightly outside [0, 1] (see
  // DEFAULT_ANCHOR_U/V in comment-pins.tsx) so the default placement reads
  // just outside a corner instead of on top of the element's own content;
  // draggable afterward to anywhere around the element (see the pin's own
  // onPointerDown in comment-pins.tsx), matching "di chuyển quanh đối
  // tượng" from the reference video.
  anchorU      Float      @default(1)
  anchorV      Float      @default(0)
  resolved     Boolean    @default(false)
  createdAt    DateTime   @default(now())

  comments WhiteboardComment[]

  @@index([whiteboardId])
  @@index([elementId])
}

model WhiteboardComment {
  id        String                  @id @default(cuid())
  threadId  String
  thread    WhiteboardCommentThread @relation(fields: [threadId], references: [id], onDelete: Cascade)
  authorId  String
  author    User                    @relation(fields: [authorId], references: [id], onDelete: Cascade)
  content   String
  createdAt DateTime                @default(now())

  @@index([threadId])
}

// One row per named person a board's owner (or a Super Admin) has explicitly
// shared it with — Google-Drive-style, see WhiteboardAccessRole and
// requireWhiteboardAccess in src/lib/access.ts. Also the row auto-created the
// first time someone reaches a board purely through its generalAccessRole
// (see that same function's step 4), so a "anyone with the link" open
// permanently adds the board to that person's own list even if general
// access is later revoked.
model WhiteboardCollaborator {
  id           String               @id @default(cuid())
  whiteboardId String
  whiteboard   Whiteboard           @relation(fields: [whiteboardId], references: [id], onDelete: Cascade)
  userId       String
  user         User                 @relation("WhiteboardCollaboratorUser", fields: [userId], references: [id], onDelete: Cascade)
  role         WhiteboardAccessRole @default(EDITOR)
  addedAt      DateTime             @default(now())
  addedById    String?
  addedBy      User?                @relation("WhiteboardCollaboratorAddedBy", fields: [addedById], references: [id], onDelete: SetNull)

  @@unique([whiteboardId, userId])
  @@index([userId])
}

model User {
  id                  String        @id @default(cuid())
  email               String        @unique
  // Nullable because a Google-first-time-created account (see the `signIn`
  // callback in src/lib/auth.ts) never sets a password — it can only ever
  // authenticate via Google. The Credentials provider's authorize() guards
  // this with a null check before bcrypt.compare.
  passwordHash        String?
  name                String
  // Public URL of a 512x512 image in the "avatars" Supabase Storage bucket
  // (see src/lib/supabase-avatar-storage.ts) — null renders as the existing
  // initials-circle fallback (see src/components/ui/user-avatar.tsx)
  // everywhere a user's identity is shown.
  avatarUrl           String?
  dateOfBirth         DateTime?     @db.Date
  phoneNumber         String?       @unique
  role                Role
  status              AccountStatus @default(ACTIVE)
  // Every STUDENT is on the 5-level ladder from the moment their account
  // exists (self-registration and Google first-sign-in both start at
  // CUSTOMER, see register/actions.ts and the signIn callback in auth.ts) —
  // there is no "no cấp" tier anymore.
  grantedLevel        Level
  // A STUDENT account created purely to be a limited admin (see
  // requireAnyAdminAccess/requireActiveStudent in src/lib/access.ts) — blocked
  // from /dashboard and excluded from student rosters/pickers, unlike a
  // regular dual-role admin (a real student additionally granted an
  // AdminPermission) which keeps studying as normal.
  adminOnly           Boolean       @default(false)
  // Middle tier between STUDENT-with-permissions and SUPER_ADMIN: a real học
  // viên (adminOnly false, grantedLevel set) that a Super Admin designated to
  // hold every content permission SUPER_ADMIN holds (see hasFullAdminAccess
  // in src/lib/access.ts), short-circuiting the AdminPermission table just
  // like SUPER_ADMIN does. Excludes /admin/settings (feature toggles), which
  // stays SUPER_ADMIN-only regardless of this flag. Eligibility is only
  // checked when this is set (setAdminManagerAction) — the write path that
  // can violate it afterward (flipping adminOnly true) clears both this and
  // canManageAdmins in the same update so the flag never survives on an
  // ineligible account.
  isAdminManager      Boolean       @default(false)
  // Separate from isAdminManager itself: an Admin Manager only reaches
  // /admin/admins (creating/editing other admins' permissions) if a Super
  // Admin explicitly also grants this — not implied by isAdminManager alone.
  // Meaningless when isAdminManager is false.
  canManageAdmins     Boolean       @default(false)
  // Purely a /admin/admins list-visibility preference, independent of actual
  // permission state — set by removeFromAdminListAction (a dedicated "xóa
  // khỏi danh sách admin" action distinct from the plain revoke-all button,
  // which intentionally leaves this false and keeps the row visible +
  // restorable). Cleared back to false the moment any permission is granted
  // again via setAccountPermissionsAction, so a re-added admin reappears.
  hiddenFromAdminList Boolean       @default(false)
  // Brute-force lockout, separate from the permanent admin-set `status:
  // LOCKED` above — auto-locks after too many wrong passwords in a row (see
  // src/lib/auth.ts authorize()), reset on the next successful login.
  failedLoginAttempts Int           @default(0)
  lockedUntil         DateTime?
  // Null = not yet verified. Only enforced at login when
  // Settings.emailVerificationEnabled is on (see the authorize() check in
  // src/lib/auth.ts) — every pre-existing row is backfilled to non-null in
  // the same migration that adds this column, so turning the toggle on never
  // retroactively locks out an account that existed before it did. A
  // Google-first-time-created account is stamped verified immediately
  // (Google already proved ownership of the address).
  emailVerified       DateTime?
  createdAt           DateTime      @default(now())
  updatedAt           DateTime      @updatedAt

  quizAttempts              QuizAttempt[]
  emailVerificationTokens   EmailVerificationToken[]    @relation("EmailVerificationTokens")
  passwordResetTokens       PasswordResetToken[]        @relation("PasswordResetTokens")
  levelUpRequests           LevelUpRequest[]            @relation("StudentRequests")
  reviewedRequests          LevelUpRequest[]            @relation("ReviewerActions")
  courseGrants              CourseAccessGrant[]         @relation("CourseGrants")
  courseGrantsGiven         CourseAccessGrant[]         @relation("CourseGrantsGiven")
  courseLessonCompletions   CourseLessonCompletion[]    @relation("CourseLessonCompletions")
  courseLessonWatchProgress CourseLessonWatchProgress[] @relation("CourseLessonWatchProgress")
  lessonCompletions         LessonCompletion[]          @relation("LessonCompletions")
  lessonWatchProgress       LessonWatchProgress[]       @relation("LessonWatchProgress")
  courseLevelGrantsGiven    CourseLevelGrant[]          @relation("CourseLevelGrantsGiven")
  announcementReads         AnnouncementRead[]
  libraryGrants             LibraryAccessGrant[]        @relation("LibraryGrants")
  libraryGrantsGiven        LibraryAccessGrant[]        @relation("LibraryGrantsGiven")
  libraryLevelGrantsGiven   LibraryLevelGrant[]         @relation("LibraryLevelGrantsGiven")
  productGrants             ProductAccessGrant[]        @relation("ProductGrants")
  productGrantsGiven        ProductAccessGrant[]        @relation("ProductGrantsGiven")
  productLevelGrantsGiven   ProductLevelGrant[]         @relation("ProductLevelGrantsGiven")
  chatMessagesSent          ChatMessage[]               @relation("ChatMessagesSent")
  chatThreadReads           ChatThreadRead[]            @relation("ChatThreadReads")
  supportThread             ChatThread?                 @relation("SupportThreadOfStudent")
  directThreadsAsUserA      ChatThread[]                @relation("DirectThreadAsUserA")
  directThreadsAsUserB      ChatThread[]                @relation("DirectThreadAsUserB")
  adminPermissions          AdminPermission[]           @relation("AdminPermissions")
  adminPermissionsGranted   AdminPermission[]           @relation("AdminPermissionsGranted")
  guestChatMessagesSent     GuestChatMessage[]          @relation("GuestChatMessagesSent")
  guestChatThreadReads      GuestChatThreadRead[]       @relation("GuestChatThreadReads")
  orders                    Order[]                     @relation("StudentOrders")
  ordersConfirmed           Order[]                     @relation("OrderConfirmedBy")
  cartItems                 CartItem[]
  consultationRequests      ConsultationRequest[]

  whiteboardsCreated           Whiteboard[]             @relation("WhiteboardsCreated")
  whiteboardsEdited            Whiteboard[]             @relation("WhiteboardsEdited")
  whiteboardCollaborations     WhiteboardCollaborator[] @relation("WhiteboardCollaboratorUser")
  whiteboardCollaboratorsAdded WhiteboardCollaborator[] @relation("WhiteboardCollaboratorAddedBy")
  whiteboardComments           WhiteboardComment[]

  // "Nhóm của tôi" — see the Group/DailyTask/CheckIn/PersonalityResult/
  // SpinResult/WeeklyRewardEntry models below for what each relation backs.
  groupMembership             GroupMembership?      @relation("GroupMembershipUser")
  dailyTasksCreated           DailyTask[]           @relation("DailyTasksCreated")
  dailyTaskAssignments        DailyTaskAssignee[]   @relation("DailyTaskAssignees")
  dailyTaskCompletions        DailyTaskCompletion[] @relation("DailyTaskCompletions")
  dailyTaskExplanationReviews DailyTaskCompletion[] @relation("DailyTaskExplanationReviews")
  checkIns                    CheckIn[]             @relation("CheckIns")
  personalityResults          PersonalityResult[]   @relation("PersonalityResults")
  personalityResultsEntered   PersonalityResult[]   @relation("PersonalityResultsEntered")
  spinResults                 SpinResult[]          @relation("SpinResults")
  weeklyRewardsReceived       WeeklyRewardEntry[]   @relation("WeeklyRewardsReceived")
  weeklyRewardsSettled        WeeklyRewardEntry[]   @relation("WeeklyRewardsSettled")

  @@index([role])
}

// Grants a STUDENT account a limited, specific slice of /admin — the
// account keeps studying at /dashboard as normal (see requireAnyAdminAccess
// in src/lib/access.ts, which is how a single-role User model supports this
// "student + limited admin" dual role without a new Role enum value).
// SUPER_ADMIN accounts bypass this table entirely and always have every
// permission implicitly.
enum AdminPermissionKind {
  MANAGE_COURSES
  MANAGE_LESSONS_QUIZZES
  MANAGE_LIBRARY
  MANAGE_STUDENTS
  MANAGE_CHAT
  MANAGE_LEVEL_UP_REQUESTS
  MANAGE_RESULTS
  MANAGE_ANNOUNCEMENTS
  // MANAGE_STUDENTS above only grants viewing the list/detail page and
  // creating new accounts — editing, locking, and deleting an existing
  // học viên are separate, independently grantable capabilities (explicit
  // user decision: e.g. an admin can be trusted to edit+lock but never
  // delete). Rendered as sub-checkboxes nested under their parent in the
  // admin-permission editor UI — see STUDENT_PERMISSION_GROUPS in
  // src/lib/admin-permissions.ts.
  EDIT_STUDENTS
  LOCK_STUDENTS
  DELETE_STUDENTS
  // Xác nhận/hủy đơn hàng mua khóa học độc quyền/tài liệu thư viện (/admin/orders)
  // — độc lập với MANAGE_COURSES/MANAGE_LIBRARY vì đây là nghiệp vụ tiền bạc,
  // không phải quản lý nội dung.
  MANAGE_ORDERS
  // Catalog sản phẩm vật lý (/admin/products) — độc lập với MANAGE_COURSES/
  // MANAGE_LIBRARY vì Product không phải nội dung số (không có access grant/
  // level gating), chỉ hiển thị cho học viên (xem requireLeveledStudent() ở
  // dashboard/products).
  MANAGE_PRODUCTS
  // Cấu trúc "Nhóm của tôi" (/admin/groups) — tạo nhóm, thêm/xóa thành viên,
  // phong/hạ trưởng-phó nhóm. Đổi cấu trúc tổ chức nên tách khỏi quyền soạn
  // nhiệm vụ hàng ngày / duyệt giải trình bên dưới, cái đó KHÔNG cần
  // AdminPermission — nó tự động đi kèm GroupMembership.role (LEADER/DEPUTY)
  // của chính người đó trong nhóm họ đang ở, xem requireOwnGroupLeadership
  // trong src/lib/access.ts.
  MANAGE_GROUPS
  // Nhập/sửa/xóa kết quả trắc nghiệm DISC/MBTI/IQ/EQ (/admin/tests) — dữ
  // liệu cá nhân nhạy cảm, tách riêng khỏi MANAGE_GROUPS để không phải admin
  // quản lý nhóm nào cũng xem được kết quả tâm lý của học viên.
  MANAGE_TESTS
  // Cấu hình vòng quay may mắn + chốt/trao thưởng bảng xếp hạng tuần
  // (/admin/minigame) — ảnh hưởng ngân sách/quà thật nên tách riêng, kiểm
  // soát tập trung thay vì để từng trưởng nhóm tự chỉnh tỉ lệ thưởng.
  MANAGE_MINIGAME
}

model AdminPermission {
  id          String              @id @default(cuid())
  userId      String
  permission  AdminPermissionKind
  grantedById String
  grantedAt   DateTime            @default(now())
  // Soft-revoke marker: null means the grant is active. Revoking sets this
  // instead of deleting the row so the grant survives to be restored later
  // (see restoreRevokedPermissionsAction in admin/admins/actions.ts, which
  // reactivates every row sharing the same revokedAt — the batch from one
  // revoke action) and so "Lịch sử cấp quyền" keeps full history.
  revokedAt   DateTime?

  user      User @relation("AdminPermissions", fields: [userId], references: [id], onDelete: Cascade)
  grantedBy User @relation("AdminPermissionsGranted", fields: [grantedById], references: [id])

  @@unique([userId, permission])
}

model Lesson {
  id              String   @id @default(cuid())
  level           Level
  title           String
  description     String?  @db.Text
  content         String   @db.Text
  youtubeId       String?
  // Same contract as CourseLesson.durationSeconds: fetched automatically
  // from the YouTube Data API whenever youtubeId is set/changed (see
  // fetchYoutubeDurationSeconds), never typed in by an admin. Null when
  // there's no video or the lookup failed — the level track just omits the
  // duration chip, and the watch gate below stays off for that lesson.
  durationSeconds Int?
  order           Int      @default(0)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  quiz Quiz?

  completions   LessonCompletion[]
  watchProgress LessonWatchProgress[]

  @@index([level, order])
}

// "This student is done with this level lesson." Deliberately a separate
// model from CourseLessonCompletion even though the shape is identical:
// Lesson (the 6-level ladder) and CourseLesson (standalone courses) are
// two unrelated tables in this schema, so their completion rows can't
// share one.
//
// A row here means the student clicked "Đánh dấu đã học" and passed
// whatever gate applied at that moment. It is NOT the whole story for a
// lesson that owns a quiz — the level track treats such a lesson as
// finished only when this row exists AND the quiz has a passing attempt
// (see getLevelLessonProgress), which keeps the level-up condition
// (passing every quiz, unchanged) strictly easier than finishing every
// lesson, never the other way round.
model LessonCompletion {
  id          String   @id @default(cuid())
  studentId   String
  student     User     @relation("LessonCompletions", fields: [studentId], references: [id], onDelete: Cascade)
  lessonId    String
  lesson      Lesson   @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  completedAt DateTime @default(now())

  @@unique([studentId, lessonId])
  @@index([studentId])
}

// Level-lesson counterpart of CourseLessonWatchProgress — same reasons for
// existing separately from LessonCompletion above (it's written from the
// first tick of playback, long before anything is complete), and same
// monotonic, actually-playing-seconds contract: seeking to the end adds
// nothing, only real playback does.
model LessonWatchProgress {
  id             String   @id @default(cuid())
  studentId      String
  student        User     @relation("LessonWatchProgress", fields: [studentId], references: [id], onDelete: Cascade)
  lessonId       String
  lesson         Lesson   @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  watchedSeconds Int      @default(0)
  updatedAt      DateTime @updatedAt

  @@unique([studentId, lessonId])
  @@index([studentId])
}

model Quiz {
  id            String   @id @default(cuid())
  lessonId      String   @unique
  lesson        Lesson   @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  title         String
  // Null means "use the global Settings.passPercentage" — set here to
  // override the pass threshold for this quiz specifically.
  passThreshold Int?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  questions Question[]
  attempts  QuizAttempt[]
}

model Question {
  id     String @id @default(cuid())
  quizId String
  quiz   Quiz   @relation(fields: [quizId], references: [id], onDelete: Cascade)
  text   String
  order  Int    @default(0)

  options AnswerOption[]

  @@index([quizId, order])
}

model AnswerOption {
  id         String   @id @default(cuid())
  questionId String
  question   Question @relation(fields: [questionId], references: [id], onDelete: Cascade)
  text       String
  isCorrect  Boolean  @default(false)
  order      Int      @default(0)

  @@index([questionId])
}

model QuizAttempt {
  id            String   @id @default(cuid())
  studentId     String
  student       User     @relation(fields: [studentId], references: [id], onDelete: Cascade)
  quizId        String
  quiz          Quiz     @relation(fields: [quizId], references: [id], onDelete: Cascade)
  answers       Json
  scorePercent  Int
  passed        Boolean
  passThreshold Int
  attemptedAt   DateTime @default(now())

  @@index([studentId])
  @@index([quizId])
}

model LevelUpRequest {
  id           String        @id @default(cuid())
  studentId    String
  student      User          @relation("StudentRequests", fields: [studentId], references: [id], onDelete: Cascade)
  fromLevel    Level
  toLevel      Level
  status       LevelUpStatus @default(PENDING)
  requestedAt  DateTime      @default(now())
  reviewedAt   DateTime?
  reviewerId   String?
  reviewer     User?         @relation("ReviewerActions", fields: [reviewerId], references: [id])
  reviewerNote String?

  @@index([studentId, status])
}

model Settings {
  id                             Int      @id @default(1)
  passPercentage                 Int      @default(80)
  chatEnabled                    Boolean  @default(true)
  // Master switch for public self-registration at /register — toggled from
  // /admin/settings (see isRegistrationEnabled in src/lib/access.ts). When
  // false, new signups are rejected; existing accounts are unaffected.
  registrationEnabled            Boolean  @default(true)
  // Master switch for the "Mua ngay" buy flow (see isSalesEnabled in
  // src/lib/access.ts) — defaults off since bank info below starts empty;
  // Super Admin turns it on once bankName/bankAccountNumber are filled in.
  // Never hides /admin/orders or a student's own order history, only new
  // purchases.
  salesEnabled                   Boolean  @default(false)
  // Master switch for the bilingual (Tiếng Việt/English) UI — toggled from
  // /admin/settings (see isBilingualEnabled in src/lib/access.ts). When
  // false, every area always renders Vietnamese regardless of a visitor's
  // saved language cookie, and the language switcher is hidden.
  bilingualEnabled               Boolean  @default(false)
  // Master switch for requiring email verification before login — toggled
  // from /admin/settings (see isEmailVerificationEnabled in src/lib/access.ts).
  // Defaults off so nothing changes until a Super Admin opts in (needs a
  // working RESEND_API_KEY configured first). When off, authorize() never
  // checks User.emailVerified at all.
  emailVerificationEnabled       Boolean  @default(false)
  // Master switch for the "Đăng nhập bằng Google" button and the Google
  // OAuth flow itself (see isGoogleLoginEnabled in src/lib/access.ts and the
  // signIn callback in src/lib/auth.ts). Defaults off so nothing changes
  // until a Super Admin opts in (needs GOOGLE_CLIENT_ID/SECRET configured
  // first). A brand-new account is only auto-created on first Google
  // sign-in if registrationEnabled is ALSO on — reuses that existing switch
  // rather than adding a second "who can register" toggle.
  googleLoginEnabled             Boolean  @default(false)
  bankName                       String?
  bankAccountNumber              String?
  bankAccountHolder              String?
  bankQrImageUrl                 String?
  // Master switch for auto-confirming orders via the SePay bank-transfer
  // webhook (see isAutoPaymentEnabled in src/lib/access.ts and
  // src/app/api/webhooks/sepay/route.ts). Read fresh at webhook-processing
  // time, never snapshotted onto an Order — flipping this off immediately
  // stops auto-confirmation for every order, including ones created while it
  // was on. When off, the webhook still accepts SePay's requests (so nothing
  // needs reconfiguring on SePay's side) but skips fulfillOrder entirely,
  // falling back to the pre-existing manual admin confirm
  // (confirmOrderPaidAction), which always stays available regardless of
  // this switch. Defaults off — needs SEPAY_WEBHOOK_SECRET configured first.
  autoPaymentEnabled             Boolean  @default(false)
  // Video-watch gate for course lessons (see CourseLessonWatchProgress) —
  // a student must accumulate this % of a lesson's real, actually-playing
  // watch time before "Đánh dấu hoàn thành" unlocks. Percent is global (one
  // knob, not per-course/per-lesson) to keep the admin UI simple; only
  // takes effect on a lesson that has a YouTube video AND a known
  // CourseLesson.durationSeconds (see fetchYoutubeDurationSeconds) — a
  // lesson missing either just behaves as before (button never locked).
  lessonWatchThresholdPercent    Int      @default(80)
  // Whether the "Đã xem N%" badge renders at all for anonymous guests on
  // /guest/* — guests have no account to persist progress against, so this
  // is purely a same-session, never-saved display; it can never lock
  // anything for a guest (there's no completion button to lock there).
  showLessonWatchProgressToGuest Boolean  @default(true)
  enforceLessonWatchForHocVien   Boolean  @default(true)
  // Single global master switch for the whole "Bảng vẽ" whiteboard feature,
  // toggled from /admin/settings (Super Admin only — see
  // isWhiteboardsEnabled/requireWhiteboardsEnabled in src/lib/access.ts).
  // Unlike most other toggles in this model, this is NOT split by audience:
  // off makes the feature unreachable for literally everyone, Super Admin
  // included; on opens it to all 3 non-guest audiences (Super Admin, Admin,
  // học viên) at once, subject to each board's own per-board sharing
  // (Whiteboard.generalAccessRole / WhiteboardCollaborator).
  whiteboardsEnabled             Boolean  @default(false)
  updatedAt                      DateTime @updatedAt
}

// One-time link token emailed on registration (and by the "Gửi lại email
// xác thực" resend action) — consumed and deleted the moment /api/verify-email
// accepts it. A user can hold more than one live row at once (each resend
// creates a new one instead of reusing/extending the old one); verifying
// with any of them deletes all of the user's rows, not just the one used.
model EmailVerificationToken {
  id        String   @id @default(cuid())
  token     String   @unique
  userId    String
  user      User     @relation("EmailVerificationTokens", fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([userId])
}

// Same shape and lifecycle as EmailVerificationToken, separate table because
// the two flows are conceptually distinct (proving address ownership vs.
// authorizing a credential change) even though the code that issues/consumes
// them is structurally identical.
model PasswordResetToken {
  id        String   @id @default(cuid())
  token     String   @unique
  userId    String
  user      User     @relation("PasswordResetTokens", fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([userId])
}

// Exclusive courses: a second, independent content track (no Level, no
// level-up gating) — a sequence of video lessons only visible to students
// the Super Admin explicitly grants access to via CourseAccessGrant.
model Course {
  id              String   @id @default(cuid())
  title           String
  description     String?  @db.Text
  coverImageUrl   String?
  order           Int      @default(0)
  // Master hide switch for the /guest/* public site: true removes the course
  // from the guest listing and blocks direct access entirely, regardless of
  // any CourseLesson.visibleToGuest flags below. Default false = listed. This
  // is intentionally NOT what gates individual trial lessons — that's driven
  // purely by CourseLesson.visibleToGuest now (see requireGuestCourseAccess /
  // requireGuestCourseLessonAccess in src/lib/access.ts).
  hiddenFromGuest Boolean  @default(false)
  // Admin-curated, independent of hiddenFromGuest: only checked by the guest
  // homepage's "Khóa học nổi bật" section, which shows exactly the courses
  // opted in here rather than just the first few by `order`.
  featuredOnHome  Boolean  @default(false)
  // VND, 0 = "không bán" (khóa học vẫn hoạt động như cũ, chỉ cấp qua
  // grant/level-rule như trước giờ) — xem OrderItem cho snapshot giá lúc mua.
  price           Int      @default(0)
  // Optional discounted price, must be < price when set — the actual amount
  // charged at checkout (see getPricing in src/lib/pricing.ts). Null = no
  // discount, full price applies. Irrelevant when isFree is true.
  salePrice       Int?
  // Master "free for everyone" switch — distinct from price = 0 ("không
  // bán", still admin-grant-only). True grants every student full access
  // outright, no order/checkout involved — checked first in
  // getCourseAccessLevel (src/lib/access.ts). Does not affect guest access,
  // which stays governed by hiddenFromGuest/CourseLesson.visibleToGuest
  // independently.
  isFree          Boolean  @default(false)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  lessons     CourseLesson[]
  chapters    CourseChapter[]
  grants      CourseAccessGrant[]
  levelGrants CourseLevelGrant[]
  orderItems  OrderItem[]
  cartItems   CartItem[]
}

// Optional grouping of lessons within a course (e.g. "Chương 01: Nhập môn")
// — purely organizational, nullable on CourseLesson so every lesson created
// before this existed just renders with no chapter badge, no backfill
// needed. The display number ("Chương N") is always derived from a
// chapter's 1-indexed position among its course's chapters ordered by
// `order`, never stored — same convention as CourseLesson's own "Bài N/Total"
// numbering, so reordering chapters can't leave a stale number sitting in
// the database.
model CourseChapter {
  id        String   @id @default(cuid())
  courseId  String
  course    Course   @relation(fields: [courseId], references: [id], onDelete: Cascade)
  title     String
  order     Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  lessons CourseLesson[]

  @@index([courseId, order])
}

model CourseLesson {
  id              String         @id @default(cuid())
  courseId        String
  course          Course         @relation(fields: [courseId], references: [id], onDelete: Cascade)
  title           String
  content         String         @db.Text
  youtubeId       String?
  // Fetched automatically from the YouTube Data API (contentDetails.duration,
  // ISO-8601 → seconds) whenever youtubeId is set/changed — see
  // fetchYoutubeDurationSeconds in src/lib/youtube-duration.ts. Never typed in
  // by an admin by hand. Null when youtubeId is null, or when the API call
  // failed (missing/invalid YOUTUBE_API_KEY, video not found, quota
  // exceeded) — the sidebar simply omits the duration badge in that case
  // rather than blocking the lesson save on an external API being reachable.
  durationSeconds Int?
  order           Int            @default(0)
  // Independent of student access entirely — only gates the /guest/* public
  // view, and only takes effect when the parent Course isn't hiddenFromGuest.
  // This is now the primary "which lessons can guests try" control (set via
  // the "Cấp quyền học thử cho khách" form on the course edit page), no
  // longer a secondary opt-in nested under a course-level visibility flag.
  visibleToGuest  Boolean        @default(false)
  // Nullable — a lesson not (yet) assigned to any chapter. SetNull rather
  // than Cascade on delete: deleting a chapter should never take its
  // lessons down with it, just un-group them.
  chapterId       String?
  chapter         CourseChapter? @relation(fields: [chapterId], references: [id], onDelete: SetNull)
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt

  completions   CourseLessonCompletion[]
  watchProgress CourseLessonWatchProgress[]

  @@index([courseId, order])
  @@index([chapterId])
}

model CourseLessonCompletion {
  id             String       @id @default(cuid())
  studentId      String
  student        User         @relation("CourseLessonCompletions", fields: [studentId], references: [id], onDelete: Cascade)
  courseLessonId String
  courseLesson   CourseLesson @relation(fields: [courseLessonId], references: [id], onDelete: Cascade)
  completedAt    DateTime     @default(now())

  @@unique([studentId, courseLessonId])
  @@index([studentId])
}

// Separate from CourseLessonCompletion on purpose — this row exists (and
// keeps getting upserted) from the very first tick of playback, long
// before a lesson is actually complete, whereas every existing
// `courseLessonCompletion.findMany(...)` call site across the app treats
// "a row exists for this lesson" as shorthand for "done" (progress
// bars/counts, sidebar checkmarks). Reusing that model here would have
// meant auditing and fixing every one of those call sites; a parallel
// model is the established convention in this schema for exactly this
// situation (see the CourseLesson-vs-Lesson split note in the same spot).
// `watchedSeconds` is monotonic (never decreases — see
// syncLessonWatchProgressAction) and is real accumulated wall-clock time
// spent actively PLAYING, not "furthest point ever reached" — resistant to
// a student seeking straight to the 80% mark without actually watching.
model CourseLessonWatchProgress {
  id             String       @id @default(cuid())
  studentId      String
  student        User         @relation("CourseLessonWatchProgress", fields: [studentId], references: [id], onDelete: Cascade)
  courseLessonId String
  courseLesson   CourseLesson @relation(fields: [courseLessonId], references: [id], onDelete: Cascade)
  watchedSeconds Int          @default(0)
  updatedAt      DateTime     @updatedAt

  @@unique([studentId, courseLessonId])
  @@index([studentId])
}

model CourseAccessGrant {
  id          String     @id @default(cuid())
  studentId   String
  student     User       @relation("CourseGrants", fields: [studentId], references: [id], onDelete: Cascade)
  courseId    String
  course      Course     @relation(fields: [courseId], references: [id], onDelete: Cascade)
  grantedAt   DateTime   @default(now())
  grantedById String?
  grantedBy   User?      @relation("CourseGrantsGiven", fields: [grantedById], references: [id])
  // Set only when this grant came from a paid order (grantedById is null in
  // that case) — the actual source of truth for "was this bought", instead
  // of inferring it from grantedById's nullability, which would get
  // ambiguous the moment a second non-admin grant source is ever added.
  // Lets the revoke UI warn with the real order details (amount, date)
  // instead of a generic "Đã mua" label. Never set on an admin-granted row.
  orderItemId String?    @unique
  orderItem   OrderItem? @relation("CourseGrantOrderItem", fields: [orderItemId], references: [id])

  @@unique([studentId, courseId])
  @@index([studentId])
}

// A continuous rule ("this course is open to Level >= minLevel"), separate
// from CourseAccessGrant's per-student rows — checked fresh alongside it in
// studentHasCourseAccess (src/lib/access.ts), so a student who levels up
// later automatically gains access with no backfill needed.
model CourseLevelGrant {
  id          String   @id @default(cuid())
  courseId    String
  course      Course   @relation(fields: [courseId], references: [id], onDelete: Cascade)
  minLevel    Level
  grantedAt   DateTime @default(now())
  grantedById String?
  grantedBy   User?    @relation("CourseLevelGrantsGiven", fields: [grantedById], references: [id])

  @@unique([courseId, minLevel])
  @@index([courseId])
}

// A separate, simpler catalog of physical products — not digital content, so
// a paid PRODUCT order (see OrderItem) only ever flips the Order to PAID;
// fulfillment (shipping the physical item) happens outside the system using
// Order.shipping* + the student's own phoneNumber, the same manual-trust
// model as payment confirmation itself. *Viewing* the product page/catalog,
// though, uses the exact same access-grant/level-gating shape as
// Course/LibraryItem (see hiddenFromGuest + ProductLevelGrant/
// ProductAccessGrant below, checked via getVisibleProductIds in
// src/lib/access.ts) — every product defaults fully public (hiddenFromGuest:
// false) so existing rows are unaffected.
model Product {
  id                 String   @id @default(cuid())
  title              String
  subtitle           String?
  description        String?  @db.Text
  // e.g. "Package" — shown as a small tag on the catalog card.
  badgeLabel         String?
  imageUrl           String?
  order              Int      @default(0)
  // VND, same convention as Course/LibraryItem.
  price              Int      @default(0)
  salePrice          Int?
  // Commission Volume — display-only figure for now; this app has no
  // compensation-plan/downline logic, just shows the number next to price.
  cv                 Int      @default(0)
  // Non-null only for the one product (today: "sanarey-aria") that gets a
  // fully bespoke landing page instead of the generic detail view — see the
  // branch in dashboard/products/[productId]/page.tsx. Every other product
  // renders the plain fallback detail page.
  slug               String?  @unique
  // Only populated (and only ever read) when slug is set — the 3 lifestyle
  // photos used by that bespoke landing page's "ai nên sử dụng" section.
  // Left null for every ordinary product.
  lifestyleImage1Url String?
  lifestyleImage2Url String?
  lifestyleImage3Url String?
  // Same convention as Course.hiddenFromGuest/LibraryItem.hiddenFromGuest —
  // a signed-in student sees at least as much as a guest does, so this only
  // ever restricts guests; students additionally need a levelGrant or
  // accessGrant once it's true (see getVisibleProductIds).
  hiddenFromGuest    Boolean  @default(false)
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  orderItems           OrderItem[]
  cartItems            CartItem[]
  consultationRequests ConsultationRequest[]
  levelGrants          ProductLevelGrant[]
  accessGrants         ProductAccessGrant[]
}

// Per-student exception list — lets an admin open a single product up to a
// specific học viên regardless of level (e.g. a preview before a launch).
// No orderItemId link (unlike CourseAccessGrant/LibraryAccessGrant): buying
// a product never auto-grants view access here, since visibility and
// purchase are unrelated concerns for physical products.
model ProductAccessGrant {
  id          String   @id @default(cuid())
  studentId   String
  student     User     @relation("ProductGrants", fields: [studentId], references: [id], onDelete: Cascade)
  productId   String
  product     Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  grantedAt   DateTime @default(now())
  grantedById String?
  grantedBy   User?    @relation("ProductGrantsGiven", fields: [grantedById], references: [id])

  @@unique([studentId, productId])
  @@index([studentId])
}

// A continuous rule ("this product is visible to Level >= minLevel"), same
// shape as CourseLevelGrant/LibraryLevelGrant — checked fresh alongside
// ProductAccessGrant in getVisibleProductIds (src/lib/access.ts), so a
// student who levels up later automatically gains visibility with no
// backfill needed.
model ProductLevelGrant {
  id          String   @id @default(cuid())
  productId   String
  product     Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  minLevel    Level
  grantedAt   DateTime @default(now())
  grantedById String?
  grantedBy   User?    @relation("ProductLevelGrantsGiven", fields: [grantedById], references: [id])

  @@unique([productId, minLevel])
  @@index([productId])
}

// A student asking to be called back about a product ("Đặt lịch tư vấn" on
// the bespoke/generic product pages) — separate from Order/CartItem
// entirely, since this is a pre-sale contact request, not a purchase.
// contactedAt is set by an admin once they've followed up (see
// /admin/consultations); nothing else in the app reads this table.
model ConsultationRequest {
  id            String    @id @default(cuid())
  productId     String
  product       Product   @relation(fields: [productId], references: [id], onDelete: Cascade)
  studentId     String
  student       User      @relation(fields: [studentId], references: [id], onDelete: Cascade)
  name          String
  phone         String
  preferredTime String
  createdAt     DateTime  @default(now())
  contactedAt   DateTime?

  @@index([productId])
  @@index([studentId])
}

// Library of books/documents (PDFs) — access control mirrors Course exactly
// (CourseAccessGrant/CourseLevelGrant), except guests never get the full
// file: visibleToGuest only unlocks previewFilePath, a server-generated
// truncated copy (first guestPreviewPages pages) built from filePath. Both
// paths point at objects in a private Supabase bucket, never a public URL —
// everything is served through our own authenticated route handlers.
model LibraryItem {
  id                String            @id @default(cuid())
  title             String
  author            String?
  description       String?           @db.Text
  type              LibraryItemType   @default(BOOK)
  // Defaults to PDF so every existing row keeps behaving exactly as before.
  // INTERACTIVE items have no filePath/previewFilePath — see LibraryBookPage
  // and requireGuestLibraryItemAccess/getLibraryItemAccessLevel in
  // src/lib/access.ts for the format-aware branches.
  format            LibraryItemFormat @default(PDF)
  coverImageUrl     String?
  // Only set (and required, enforced at the action layer, not by the
  // schema) when format is PDF — INTERACTIVE items have no uploaded file.
  filePath          String?
  // "N trang" for list views either way — for INTERACTIVE items this is
  // just pages.length, kept in sync on every saveLibraryBookPagesAction.
  pageCount         Int?
  // Fixed design-pixel canvas size for an INTERACTIVE item, chosen once in
  // the editor and not resizable after (every element's x/y/width/height in
  // LibraryBookPage.elements is relative to this). Null for PDF items.
  bookWidth         Int?
  bookHeight        Int?
  previewFilePath   String?
  guestPreviewPages Int?
  order             Int               @default(0)
  visibleToGuest    Boolean           @default(false)
  // Master hide switch, same convention as Announcement.visibleToStudents:
  // false pulls the item from student and guest access alike (overriding
  // visibleToGuest and any grants) without deleting it or touching grants.
  // Defaults true so existing rows keep showing up unchanged.
  visibleToStudents Boolean           @default(true)
  // Admin-curated, independent of visibleToGuest: only checked by the guest
  // homepage's "Ebook nổi bật" section, same convention as Course.featuredOnHome.
  featuredOnHome    Boolean           @default(false)
  // VND, 0 = "không bán", same convention as Course.price.
  price             Int               @default(0)
  // Optional discounted price, same convention as Course.salePrice.
  salePrice         Int?
  // Master "free for everyone" switch, same convention as Course.isFree.
  isFree            Boolean           @default(false)
  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt

  grants      LibraryAccessGrant[]
  levelGrants LibraryLevelGrant[]
  orderItems  OrderItem[]
  cartItems   CartItem[]
  bookPages   LibraryBookPage[]

  @@index([type, order])
}

// One row per page of an INTERACTIVE-format LibraryItem, composed in the
// admin editor (src/app/admin/library/[itemId]/editor). `elements` is a
// JSON array of positioned items (text/image/shape/button/video/audio),
// validated by the shared zod schema in src/lib/library-book-elements.ts —
// not enforced at the DB layer. Saved via saveLibraryBookPagesAction as a
// full delete-and-recreate transaction (see setCourseGuestAccessAction for
// the same pattern), so `order` is simply the array index at save time.
model LibraryBookPage {
  id                 String      @id @default(cuid())
  libraryItemId      String
  libraryItem        LibraryItem @relation(fields: [libraryItemId], references: [id], onDelete: Cascade)
  order              Int
  backgroundColor    String?
  backgroundImageUrl String?
  elements           Json
  createdAt          DateTime    @default(now())
  updatedAt          DateTime    @updatedAt

  @@index([libraryItemId, order])
}

model LibraryAccessGrant {
  id            String      @id @default(cuid())
  studentId     String
  student       User        @relation("LibraryGrants", fields: [studentId], references: [id], onDelete: Cascade)
  libraryItemId String
  libraryItem   LibraryItem @relation(fields: [libraryItemId], references: [id], onDelete: Cascade)
  grantedAt     DateTime    @default(now())
  grantedById   String?
  grantedBy     User?       @relation("LibraryGrantsGiven", fields: [grantedById], references: [id])
  // Same convention as CourseAccessGrant.orderItemId — the real source of
  // truth for "was this bought", set only for order-fulfilled rows.
  orderItemId   String?     @unique
  orderItem     OrderItem?  @relation("LibraryGrantOrderItem", fields: [orderItemId], references: [id])

  @@unique([studentId, libraryItemId])
  @@index([studentId])
}

// A continuous rule ("this item is open to Level >= minLevel"), separate
// from LibraryAccessGrant's per-student rows — checked fresh alongside it in
// studentHasLibraryItemAccess (src/lib/access.ts), same pattern as
// CourseLevelGrant.
model LibraryLevelGrant {
  id            String      @id @default(cuid())
  libraryItemId String
  libraryItem   LibraryItem @relation(fields: [libraryItemId], references: [id], onDelete: Cascade)
  minLevel      Level
  grantedAt     DateTime    @default(now())
  grantedById   String?
  grantedBy     User?       @relation("LibraryLevelGrantsGiven", fields: [grantedById], references: [id])

  @@unique([libraryItemId, minLevel])
  @@index([libraryItemId])
}

// Bán khóa học độc quyền/tài liệu thư viện qua chuyển khoản ngân hàng thủ
// công (SePay dự kiến tích hợp sau — xem fulfillOrder trong
// src/lib/order-fulfillment.ts, hàm duy nhất cần gọi lại khi có webhook tự
// động, không cần đổi schema). "Đã thanh toán" chỉ đơn giản là tạo đúng
// CourseAccessGrant/LibraryAccessGrant row mà admin vẫn cấp tay bấy lâu nay
// (grantedById: null = hệ thống cấp qua đơn hàng) — không có logic quyền
// riêng nào ở đây, src/lib/access.ts không cần biết Order tồn tại.
model Order {
  id            String      @id @default(cuid())
  // Số ngắn, duy nhất, dùng làm nội dung chuyển khoản — hiển thị dạng
  // "DH" + số này (xem formatOrderCode trong src/lib/orders.ts).
  orderNumber   Int         @unique @default(autoincrement())
  studentId     String
  student       User        @relation("StudentOrders", fields: [studentId], references: [id], onDelete: Cascade)
  status        OrderStatus @default(PENDING)
  totalAmount   Int
  createdAt     DateTime    @default(now())
  paidAt        DateTime?
  cancelledAt   DateTime?
  confirmedById String?
  confirmedBy   User?       @relation("OrderConfirmedBy", fields: [confirmedById], references: [id])

  // Only collected (and only ever read) for a PRODUCT order — a physical
  // good needs somewhere to be shipped, unlike Course/LibraryItem which just
  // grant digital access. Null for every COURSE/LIBRARY_ITEM order. Captured
  // once at checkout (createOrderAction) rather than re-derived from the
  // student's profile, since User has no address field and this may differ
  // from where the buyer actually lives.
  shippingName    String?
  shippingPhone   String?
  shippingAddress String? @db.Text

  // Soft-delete only — set by deleteOrderAction (Super Admin only), which
  // just hides the row from /admin/orders immediately. The row itself (and
  // its OrderItems) is only actually removed once ORDER_TRASH_RETENTION_DAYS
  // (src/lib/orders.ts) have passed, opportunistically purged on the next
  // /admin/orders page load — see purgeExpiredDeletedOrders. Deleting (soft
  // or eventual hard) never revokes access already granted: CourseAccessGrant/
  // LibraryAccessGrant.orderItemId is ON DELETE SET NULL, so a hard purge
  // only orphans the grant from any order record, the student keeps it.
  deletedAt DateTime?

  items OrderItem[]

  @@index([studentId])
  @@index([status])
  @@index([deletedAt])
}

// Discriminated by kind, same convention as ChatThread: exactly one of
// courseId/libraryItemId/productId is populated, matching kind. titleSnapshot/
// priceAtPurchase freeze what was actually paid for — the underlying
// Course/LibraryItem/Product's title or price may change later.
model OrderItem {
  id              String        @id @default(cuid())
  orderId         String
  order           Order         @relation(fields: [orderId], references: [id], onDelete: Cascade)
  kind            OrderItemKind
  courseId        String?
  course          Course?       @relation(fields: [courseId], references: [id])
  libraryItemId   String?
  libraryItem     LibraryItem?  @relation(fields: [libraryItemId], references: [id])
  // PRODUCT order item — see fulfillOrder in src/lib/order-fulfillment.ts,
  // which deliberately creates no access-grant row for this kind (nothing to
  // grant on a physical good).
  productId       String?
  product         Product?      @relation(fields: [productId], references: [id])
  titleSnapshot   String
  priceAtPurchase Int

  // Back-relations to whichever access grant this item's fulfillment
  // created (at most one of the two, matching kind) — see
  // CourseAccessGrant.orderItemId / LibraryAccessGrant.orderItemId.
  courseAccessGrant  CourseAccessGrant?  @relation("CourseGrantOrderItem")
  libraryAccessGrant LibraryAccessGrant? @relation("LibraryGrantOrderItem")

  @@index([orderId])
}

// Pre-checkout cart — separate from Order/OrderItem on purpose: a row here
// is just "the student picked this," freely added/removed with no order
// yet, and never shown to admin. confirmCartOrderAction (src/app/dashboard/
// cart/actions.ts) is the only place that turns a set of these into one real
// (possibly multi-item) Order and clears the rows it consumed — reusing a
// PENDING Order as the cart itself would have let admin see, and possibly
// act on, an order the student is still actively editing.
model CartItem {
  id            String        @id @default(cuid())
  studentId     String
  student       User          @relation(fields: [studentId], references: [id], onDelete: Cascade)
  kind          OrderItemKind
  courseId      String?
  course        Course?       @relation(fields: [courseId], references: [id])
  libraryItemId String?
  libraryItem   LibraryItem?  @relation(fields: [libraryItemId], references: [id])
  productId     String?
  product       Product?      @relation(fields: [productId], references: [id])
  createdAt     DateTime      @default(now())

  @@index([studentId])
}

// In-app announcements (bản tin) — two audiences (khách/học viên) are each
// independently opt-in per post, no per-student overrides since nothing
// has asked for that yet.
model Announcement {
  id                String               @id @default(cuid())
  title             String
  content           String               @db.Text
  coverImageUrl     String?
  category          AnnouncementCategory @default(GENERAL)
  // Only meaningful when visibleToLeveled is true — the admin form always
  // submits a concrete Level in that case (picking the lowest level, Cấp 1,
  // is how "every học viên" is expressed; there is no separate "no minimum"
  // state). Stays nullable because pre-migration rows were backfilled with
  // minLevel left as-is (see the migration for how their effective
  // visibility was preserved).
  minLevel          Level?
  visibleToGuest    Boolean              @default(false)
  // False means no học viên can see this announcement at all, regardless of
  // minLevel. See announcementVisibleTo() in src/lib/announcements.ts.
  visibleToLeveled  Boolean              @default(false)
  // Master hide switch: false pulls the announcement from every audience at
  // once (students AND guests), overriding visibleToGuest/visibleToLeveled —
  // without deleting it. Defaults true so existing rows keep showing up
  // unchanged.
  visibleToStudents Boolean              @default(true)
  publishedAt       DateTime             @default(now())
  createdAt         DateTime             @default(now())
  updatedAt         DateTime             @updatedAt

  reads AnnouncementRead[]

  @@index([publishedAt])
  @@index([category])
}

model AnnouncementRead {
  id             String       @id @default(cuid())
  studentId      String
  student        User         @relation(fields: [studentId], references: [id], onDelete: Cascade)
  announcementId String
  announcement   Announcement @relation(fields: [announcementId], references: [id], onDelete: Cascade)
  readAt         DateTime     @default(now())

  @@unique([studentId, announcementId])
  @@index([studentId])
}

// One row per conversation regardless of kind — a support message, a DM, and
// a group message are structurally identical (sender/body/attachment), so a
// single discriminated model avoids tripling the message/read schema. Exactly
// one of the three identity fields below is populated, matching `kind`:
//   SUPPORT -> supportStudentId only. The admin side isn't a stored member —
//              any active SUPER_ADMIN may access it (see
//              userCanAccessChatThread in src/lib/access.ts).
//   DIRECT  -> directUserAId + directUserBId, always stored with the
//              lexicographically smaller User.id first (see orderedPair in
//              src/lib/chat.ts) so a pair has exactly one canonical row.
//   GROUP   -> groupLevel only. Membership is never stored — it's the
//              student's *current* grantedLevel re-checked live on every
//              access via hasLevelAccess's >= rule (same as content gating
//              elsewhere), so a student reaches their room plus every room
//              below it. Admins reach every group room regardless of level.
// All three kinds' threads are created lazily (upsert on the relevant unique
// key) the first time a message is sent, mirroring AnnouncementRead's
// create-on-first-need idiom — no seeding required.
model ChatThread {
  id   String         @id @default(cuid())
  kind ChatThreadKind

  supportStudentId String? @unique
  supportStudent   User?   @relation("SupportThreadOfStudent", fields: [supportStudentId], references: [id], onDelete: Cascade)

  directUserAId String?
  directUserA   User?   @relation("DirectThreadAsUserA", fields: [directUserAId], references: [id], onDelete: Cascade)
  directUserBId String?
  directUserB   User?   @relation("DirectThreadAsUserB", fields: [directUserBId], references: [id], onDelete: Cascade)

  groupLevel Level? @unique

  // Denormalized for cheap inbox ordering/preview without an aggregate query
  // per row — updated in the same transaction as each new ChatMessage.
  lastMessageAt      DateTime @default(now())
  lastMessagePreview String?
  createdAt          DateTime @default(now())

  messages ChatMessage[]
  reads    ChatThreadRead[]

  @@unique([directUserAId, directUserBId])
  @@index([kind])
}

model ChatMessage {
  id             String     @id @default(cuid())
  threadId       String
  thread         ChatThread @relation(fields: [threadId], references: [id], onDelete: Cascade)
  senderId       String
  sender         User       @relation("ChatMessagesSent", fields: [senderId], references: [id], onDelete: Cascade)
  // Nullable together with the four attachment fields below — a message may
  // be attachment-only. At least one of body/attachmentPath is required,
  // enforced by Zod at the server-action boundary (see src/lib/chat.ts),
  // not a DB constraint, matching how this schema keeps validation at the
  // Zod layer rather than CHECK constraints throughout.
  body           String?    @db.Text
  // Object path in the private `chat-attachments` Supabase bucket, never a
  // public URL — same convention as LibraryItem.filePath. Served only
  // through /api/chat/attachments/[messageId], gated by
  // userCanAccessChatThread.
  attachmentPath String?
  attachmentName String?
  attachmentMime String?
  attachmentSize Int?
  createdAt      DateTime   @default(now())

  @@index([threadId, createdAt])
}

// A per-user watermark, not a per-message row like AnnouncementRead — a
// thread can have hundreds of messages, so "unread" is computed as
// messages.createdAt > lastReadAt AND senderId != me, rather than one row
// per message per reader.
model ChatThreadRead {
  id         String     @id @default(cuid())
  threadId   String
  thread     ChatThread @relation(fields: [threadId], references: [id], onDelete: Cascade)
  userId     String
  user       User       @relation("ChatThreadReads", fields: [userId], references: [id], onDelete: Cascade)
  lastReadAt DateTime   @default(now())

  @@unique([threadId, userId])
  @@index([userId])
}

enum GuestChatSender {
  GUEST
  ADMIN
}

// Deliberately separate from ChatThread/ChatMessage rather than adding a
// fourth ChatThreadKind — every field on those models keys off a real
// User.id (senderId, supportStudentId, etc. are all non-nullable FKs), and
// a guest visitor never has a User row (see requireAnyAdminAccess and the
// User model comment for the other half of "who can act as admin" — this
// is the "who is the OTHER party" half, for anonymous visitors instead).
// Identified purely by an opaque cookie value (see getOrCreateGuestSessionId
// in src/lib/guest-chat.ts) — no name/email is ever collected, matching the
// site's "fully anonymous" guest chat design.
model GuestChatThread {
  id             String @id @default(cuid())
  guestSessionId String @unique

  lastMessageAt      DateTime @default(now())
  lastMessagePreview String?
  createdAt          DateTime @default(now())

  messages GuestChatMessage[]
  reads    GuestChatThreadRead[]
}

model GuestChatMessage {
  id       String          @id @default(cuid())
  threadId String
  thread   GuestChatThread @relation(fields: [threadId], references: [id], onDelete: Cascade)
  sender   GuestChatSender

  // Set only when sender = ADMIN — which admin replied, for the "who
  // answered" context an admin sees; a GUEST-sent message has no User to
  // attribute (that's the whole point of the anonymous cookie identity).
  senderAdminId String?
  senderAdmin   User?   @relation("GuestChatMessagesSent", fields: [senderAdminId], references: [id], onDelete: SetNull)

  // Text-only for this first cut, unlike ChatMessage — no attachment
  // support yet for anonymous guests.
  body      String   @db.Text
  createdAt DateTime @default(now())

  @@index([threadId, createdAt])
}

// Per-admin read watermark, same idiom as ChatThreadRead — any admin with
// MANAGE_CHAT may reply, so unread is tracked per admin, not per thread.
model GuestChatThreadRead {
  id         String          @id @default(cuid())
  threadId   String
  thread     GuestChatThread @relation(fields: [threadId], references: [id], onDelete: Cascade)
  adminId    String
  admin      User            @relation("GuestChatThreadReads", fields: [adminId], references: [id], onDelete: Cascade)
  lastReadAt DateTime        @default(now())

  @@unique([threadId, adminId])
  @@index([adminId])
}

// ============================================================================
// "Nhóm của tôi" — team structure, daily tasks, check-in/streak, personality
// results (admin-entered, no scoring engine), and the spin-to-win mini-game.
// Independent of the 5-level ladder (Level) and of ChatThreadKind.GROUP
// (level-based chat rooms) — Group here is an organizational team a
// SUPER_ADMIN/MANAGE_GROUPS admin assigns students into.
// ============================================================================

enum GroupRole {
  LEADER
  DEPUTY
  MEMBER
}

// A team every đối tác chính thức can be assigned into. Admin-managed only
// (MANAGE_GROUPS) — there is no self-service "join a group" flow.
model Group {
  id        String   @id @default(cuid())
  name      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  memberships         GroupMembership[]
  dailyTasks          DailyTask[]
  weeklyRewardEntries WeeklyRewardEntry[]

  @@index([name])
}

// One row per student per group — a student belongs to at most one group at
// a time (@@unique([userId])); moving someone to another group is an update
// of this row's groupId, not a new row. `role` is the single source of
// truth for whether this person can author DailyTask/review explanations
// for the group (LEADER/DEPUTY, see requireOwnGroupLeadership in
// src/lib/access.ts) — deliberately NOT modeled via AdminPermission, since
// every leader needs this for their own group with zero admin setup.
model GroupMembership {
  id       String    @id @default(cuid())
  groupId  String
  group    Group     @relation(fields: [groupId], references: [id], onDelete: Cascade)
  userId   String    @unique
  user     User      @relation("GroupMembershipUser", fields: [userId], references: [id], onDelete: Cascade)
  role     GroupRole @default(MEMBER)
  joinedAt DateTime  @default(now())

  @@index([groupId])
}

enum DailyTaskCategory {
  CALL
  READING
  EXERCISE
  NOTE
  OTHER
}

enum DailyTaskFrequency {
  ONCE
  DAILY
  WEEKLY_DAYS
}

// A to-do a group's LEADER/DEPUTY assigns to their group — completion is
// tracked per member per day via DailyTaskCompletion, not on this row.
// `frequency` decides which calendar days this task is "live" starting from
// `startDate`: ONCE only that date itself, DAILY every day from then on,
// WEEKLY_DAYS only the ISO weekdays (1=Mon..7=Sun) listed in `weekdays`.
// `category` is purely cosmetic (which icon the student dashboard shows).
model DailyTask {
  id                 String             @id @default(cuid())
  groupId            String
  group              Group              @relation(fields: [groupId], references: [id], onDelete: Cascade)
  // Non-null only for tasks produced by one "giao việc hàng loạt" run
  // (/admin/groups/assign): every per-group copy of that run shares one id.
  // A DailyTask deliberately stays one-row-per-group — getTaskAudienceUserIds,
  // getTodayTasksForUser and DailyTaskCompletion's @@unique([taskId, userId,
  // date]) all assume it — so "one task sent to N groups" is N sibling rows
  // tied together by this column rather than a groups join table. That's what
  // lets the whole run be counted and removed as a unit instead of N
  // unrelated tasks. It doubles as the "authored by an admin, not by the
  // group's own LEADER/DEPUTY" marker: leadership must not manage these (see
  // isTaskManageableByLeadership in src/lib/groups.ts).
  batchId            String?
  title              String
  description        String?            @db.Text
  category           DailyTaskCategory  @default(OTHER)
  frequency          DailyTaskFrequency @default(DAILY)
  // Only meaningful when frequency = WEEKLY_DAYS; ISO weekday numbers
  // stored as a plain array rather than a join table — small, fixed-size,
  // never queried on its own.
  weekdays           Int[]
  startDate          DateTime           @db.Date
  // "HH:MM" 24h text, not a DateTime — this is a daily-recurring deadline,
  // not tied to one calendar date. Compared against the current time in the
  // app layer to decide when an untouched day flips from "due" to "missed".
  dueTime            String             @default("23:59")
  // Whether the audience is the group's entire live membership (evaluated
  // fresh each time, never snapshotted — someone added to the group later
  // still gets an assignAllMembers task automatically) or the explicit
  // subset in DailyTaskAssignee below.
  assignAllMembers   Boolean            @default(true)
  requireExplanation Boolean            @default(true)
  points             Int                @default(0)
  createdById        String
  createdBy          User               @relation("DailyTasksCreated", fields: [createdById], references: [id])
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt

  assignees   DailyTaskAssignee[]
  completions DailyTaskCompletion[]

  @@index([groupId])
  @@index([batchId])
}

// Only rows exist when DailyTask.assignAllMembers = false — an explicit
// subset of the group's members this task applies to.
model DailyTaskAssignee {
  id     String    @id @default(cuid())
  taskId String
  task   DailyTask @relation(fields: [taskId], references: [id], onDelete: Cascade)
  userId String
  user   User      @relation("DailyTaskAssignees", fields: [userId], references: [id], onDelete: Cascade)

  @@unique([taskId, userId])
  @@index([userId])
}

enum DailyTaskCompletionStatus {
  DONE
  MISSED
  EXPLAINED_PENDING
  EXPLAINED_APPROVED
  EXPLAINED_REJECTED
}

// One row per (task, student, date) — created lazily the first time a
// student interacts with a task on a given day (ticking done, or
// submitting an explanation). A day with no row for an assigned student
// reads as MISSED once dueTime has passed, without needing a row to exist.
// `date` is the specific calendar day this completion is for (not
// DailyTask.startDate) since a DAILY/WEEKLY_DAYS task produces a fresh
// completion each day it's live.
model DailyTaskCompletion {
  id     String                    @id @default(cuid())
  taskId String
  task   DailyTask                 @relation(fields: [taskId], references: [id], onDelete: Cascade)
  userId String
  user   User                      @relation("DailyTaskCompletions", fields: [userId], references: [id], onDelete: Cascade)
  date   DateTime                  @db.Date
  status DailyTaskCompletionStatus @default(MISSED)

  explanationText String?   @db.Text
  explainedAt     DateTime?
  reviewedById    String?
  reviewedBy      User?     @relation("DailyTaskExplanationReviews", fields: [reviewedById], references: [id], onDelete: SetNull)
  reviewedAt      DateTime?

  completedAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@unique([taskId, userId, date])
  @@index([userId, date])
}

// One row per student per calendar day they checked in. Current/best streak
// are both derived at query time from consecutive rows here, never stored
// as a counter — same "derive, don't snapshot" convention as
// hasLevelAccess/getCourseAccessLevel elsewhere in this app.
model CheckIn {
  id     String   @id @default(cuid())
  userId String
  user   User     @relation("CheckIns", fields: [userId], references: [id], onDelete: Cascade)
  date   DateTime @db.Date

  createdAt DateTime @default(now())

  @@unique([userId, date])
  @@index([userId])
}

enum PersonalityTestType {
  DISC
  MBTI
  IQ
  EQ
}

// Purely descriptive, admin-authored metadata for one of the 4 fixed "Khám
// phá bản thân" cards — title/description/estimatedMinutes/questionCount
// are plain display text, NOT derived from a real question bank. This app
// deliberately does not implement DISC/MBTI/IQ/EQ scoring — see
// PersonalityResult, which an admin fills in by hand per student instead.
model PersonalityTest {
  id               String              @id @default(cuid())
  type             PersonalityTestType @unique
  title            String
  description      String?             @db.Text
  estimatedMinutes Int?
  questionCount    Int?
  updatedAt        DateTime            @updatedAt

  results PersonalityResult[]
}

// A student's result for one PersonalityTest, typed in by an admin
// (MANAGE_TESTS) after the student takes the test somewhere outside this
// app. `note` is admin-only context, never shown to the student.
model PersonalityResult {
  id          String          @id @default(cuid())
  testId      String
  test        PersonalityTest @relation(fields: [testId], references: [id], onDelete: Cascade)
  userId      String
  user        User            @relation("PersonalityResults", fields: [userId], references: [id], onDelete: Cascade)
  resultLabel String
  note        String?         @db.Text
  enteredById String
  enteredBy   User            @relation("PersonalityResultsEntered", fields: [enteredById], references: [id])
  enteredAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt

  @@unique([testId, userId])
  @@index([userId])
}

enum SpinRewardType {
  POINTS
  EXTRA_SPIN
  NONE
}

// One wheel segment (MANAGE_MINIGAME) — `weightPercent` across all rows
// should sum to 100 (enforced in the app layer only, not a DB constraint);
// `order` decides the wheel's visual position, matching the admin editor's
// row order.
model SpinReward {
  id            String         @id @default(cuid())
  label         String
  type          SpinRewardType @default(POINTS)
  value         Int            @default(0)
  weightPercent Int            @default(0)
  order         Int            @default(0)
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt

  results SpinResult[]

  @@index([order])
}

// One row per spin a student takes — the immutable history backing "lượt
// quay còn lại hôm nay" (count today's rows against the daily allowance
// computed in the app layer) and the points a spin awarded (reward.type =
// POINTS, folded into the same weekly-points derivation as
// DailyTaskCompletion).
model SpinResult {
  id       String     @id @default(cuid())
  userId   String
  user     User       @relation("SpinResults", fields: [userId], references: [id], onDelete: Cascade)
  rewardId String
  reward   SpinReward @relation(fields: [rewardId], references: [id])
  spunAt   DateTime   @default(now())

  @@index([userId, spunAt])
}

enum WeeklyRewardScope {
  ALL
  GROUP
}

// One row per winner per settled week, created by the admin "Chốt & trao
// thưởng tuần này" action (MANAGE_MINIGAME). `scope`/`groupId` record
// whether that settlement was for the whole system or one specific group;
// weekStart is always that week's Monday. The unique constraint below only
// actually stops a duplicate week+scope+rank for the GROUP scope — standard
// SQL uniqueness never treats two NULLs as equal, so it's silently inert
// when groupId is NULL (the ALL scope). settleWeeklyRewardsAction guards
// that case itself with a Serializable transaction around its own
// check-then-insert instead of relying on this constraint.
model WeeklyRewardEntry {
  id          String            @id @default(cuid())
  weekStart   DateTime          @db.Date
  scope       WeeklyRewardScope
  groupId     String?
  group       Group?            @relation(fields: [groupId], references: [id], onDelete: SetNull)
  rank        Int
  userId      String
  user        User              @relation("WeeklyRewardsReceived", fields: [userId], references: [id], onDelete: Cascade)
  prizeText   String
  settledById String
  settledBy   User              @relation("WeeklyRewardsSettled", fields: [settledById], references: [id])
  settledAt   DateTime          @default(now())

  @@unique([weekStart, scope, groupId, rank])
  @@index([userId])
}
